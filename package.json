{
  "name": "docreview",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "node scripts/check-deps.mjs && node scripts/check-db.mjs && next dev",
    "dev:offline": "node scripts/check-deps.mjs && node scripts/check-db.mjs && OFFLINE_MODE=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:snapshot && pnpm test:e2e:app-offline",
    "test:e2e:snapshot": "pnpm exec playwright test --config testing/extension-snapshot/playwright.config.ts",
    "test:e2e:app-offline": "pnpm exec playwright test --config testing/app-offline/playwright.config.ts",
    "test:e2e:extension-live": "pnpm exec playwright test --config testing/extension-live/playwright.config.ts",
    "test:e2e:app-live": "pnpm exec playwright test --config testing/app-live/playwright.config.ts",
    "dev:test-live": "testing/dev-test.sh",
    "dev:test-offline": "testing/dev-test.sh --offline",
    "test:open-browser": "pnpm exec playwright open --channel chrome http://localhost:3009",
    "test:open-browser-live": "testing/open-browser-live.sh",
    "test:open-browser-extension": "testing/open-browser-with-extension.sh",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@googleapis/docs": "^9.3.0",
    "@googleapis/drive": "^20.2.0",
    "@googleapis/gmail": "^16.1.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^0.575.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.3",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-draggable": "^4.7.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
