{
  "name": "docreview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-deps.mjs && node scripts/check-db.mjs && next dev",
    "dev:offline": "node scripts/check-deps.mjs && node scripts/check-db.mjs && OFFLINE_MODE=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:snapshot && npm run test:e2e:app-offline",
    "test:e2e:snapshot": "npx playwright test --config testing/extension-snapshot/playwright.config.ts",
    "test:e2e:app-offline": "npx playwright test --config testing/app-offline/playwright.config.ts",
    "test:e2e:extension-live": "npx playwright test --config testing/extension-live/playwright.config.ts",
    "test:e2e:app-live": "npx playwright test --config testing/app-live/playwright.config.ts",
    "dev:test-live": "testing/dev-test.sh",
    "dev:test-offline": "testing/dev-test.sh --offline",
    "test:open-browser": "npx playwright open --channel chrome http://localhost:3009",
    "test:open-browser-live": "testing/open-browser-live.sh",
    "test:open-browser-extension": "testing/open-browser-with-extension.sh",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@googleapis/docs": "^9.2.1",
    "@googleapis/drive": "^20.1.0",
    "@googleapis/gmail": "^16.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.8",
    "google-auth-library": "^10.6.1",
    "lucide-react": "^0.575.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.0",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-draggable": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.1.38",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
