# Copy to .env and fill in. See README.md for full setup instructions.

# --- Required ---

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/docreview"

# NextAuth session secret — generate with: pnpm dlx auth secret
AUTH_SECRET=""

# Google OAuth 2.0 client credentials (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Optional ---

# Comma-separated allowlist of email addresses permitted to sign in.
# Unset means anyone who can reach the server and pass Google OAuth gets an account.
# ALLOWED_EMAILS="you@example.com,teammate@example.com"

# Link used by the in-app "Chrome extension" pointer.
# Defaults to the GitHub source directory if unset.
# NEXT_PUBLIC_CHROME_EXTENSION_URL=""

# Readonly connection used by scripts/query_database.sh — see README "Readonly database user"
# DATABASE_URL_RO="postgresql://docreview_ro:PASSWORD@localhost:5432/docreview"

# --- Behind a reverse proxy (Nginx, Caddy, cloud dev proxy) ---
# Also add the https callback URL to your OAuth client's authorized redirect URIs.
# AUTH_URL="https://myapp.example.com"
# AUTH_TRUST_HOST=true

# --- Offline mode (no Google OAuth; see README "Offline Mode") ---
# Normally set via `pnpm dev:offline` rather than here.
# OFFLINE_MODE=true
# OFFLINE_USER_ID=""
