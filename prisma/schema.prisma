// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  docs          Doc[]
  labels        Label[]
  status        Status?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Status {
  userId                   String    @id
  lastDriveUpdateTimestamp  DateTime?
  lastGmailUpdateTimestamp  DateTime?
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Enums
enum DocRole {
  AUTHOR
  REVIEWER
}

enum DocStatus {
  ACTIVE
  ARCHIVED
}

enum CommentType {
  COMMENT
  SUGGESTION
}

enum SuggestionType {
  INSERT
  DELETE
  EDIT
}

enum CommentStatus {
  ACTIVE
  ARCHIVED
  MUTED
}

// App models
model Label {
  id     String     @id @default(cuid())
  userId String
  name   String
  color  String?
  position Int      @default(0)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docs   DocLabel[]

  @@unique([userId, name])
}

model Doc {
  id                   String     @id @default(cuid())
  userId               String
  googleDocId          String
  title                String
  driveUrl             String
  mimeType             String?
  role                 DocRole    @default(REVIEWER)
  status               DocStatus  @default(ACTIVE)
  isDeleted            Boolean    @default(false)
  lastModifiedInDrive  DateTime?
  owner                String?
  createdTimeInDrive   DateTime?
  addedAt              DateTime   @default(now())
  commentsLastSyncedAt DateTime?
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  labels               DocLabel[]
  comments             Comment[]

  @@unique([userId, googleDocId])
}

model Comment {
  id              String         @id @default(cuid())
  docId           String
  googleCommentId String
  type            CommentType    @default(COMMENT)
  suggestionType  SuggestionType?
  resolved        Boolean        @default(false)
  isThreadAuthor  Boolean        @default(false)
  iParticipated   Boolean        @default(false)
  status          CommentStatus  @default(ACTIVE)
  driveCreatedAt  DateTime?
  driveModifiedAt DateTime?
  replyCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  doc             Doc            @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, googleCommentId])
}

model DocLabel {
  docId   String
  labelId String
  doc     Doc    @relation(fields: [docId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([docId, labelId])
}
