// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models — see docs/auth.md for how these interact.
//
// User:    The identity. One row per person. All app data (docs, labels, etc.)
//          hangs off this. Created on first sign-in.
//
// Account: Links a User to an OAuth provider (Google). Stores the access_token
//          and refresh_token used to call Google APIs on the user's behalf.
//          One row per provider per user. Tokens are updated on sign-in
//          (events.signIn in src/auth.ts) and on automatic refresh
//          (oauth2Client.on("tokens") in src/lib/google-drive.ts).
//
// Session: Maps a browser cookie (session_token) to a User. Created on sign-in,
//          deleted on sign-out. This is how NextAuth identifies who is making
//          each request — it has nothing to do with Google tokens.

model User {
  id            String    @id @default(cuid()) @map("user_id")
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  docs          Doc[]
  labels        Label[]
  status        Status?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid()) @map("account_id")
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? // long-lived; used to obtain new access_tokens without user interaction
  access_token      String? // short-lived (~1hr); sent with every Google API call
  expires_at        Int?    // unix timestamp when access_token expires
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("session_id")
  sessionToken String   @unique @map("session_token") // random string stored as browser cookie
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Used by NextAuth for email-based (passwordless) sign-in flows.
// Not currently used — we only support Google OAuth — but required by PrismaAdapter.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Status {
  userId                   String    @id @map("user_id")
  lastGmailUpdateTimestamp  DateTime? @map("last_gmail_update_timestamp")
  driveChangesPageToken    String?   @map("drive_changes_page_token")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("statuses")
}

// Enums
enum DocRole {
  AUTHOR
  REVIEWER

  @@map("doc_role")
}

enum DocStatus {
  INBOX
  ARCHIVED

  @@map("doc_status")
}

enum CommentType {
  COMMENT
  SUGGESTION

  @@map("comment_type")
}

enum SuggestionType {
  INSERT
  DELETE
  EDIT

  @@map("suggestion_type")
}

// See docs/access-states.md for state transitions and display behavior.
enum AccessState {
  OK
  TRASHED
  NOT_FOUND
  DENIED

  @@map("access_state")
}

enum CommentStatus {
  INBOX
  ARCHIVED
  MUTED

  @@map("comment_status")
}

// App models
model Label {
  labelId String     @id @default(cuid()) @map("label_id")
  userId  String     @map("user_id")
  name   String
  color  String?
  position Int      @default(0)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  docs   DocLabel[]

  @@unique([userId, name])
  @@map("labels")
}

model Doc {
  docId                String     @id @default(cuid()) @map("doc_id")
  userId               String     @map("user_id")
  googleDocId          String     @map("google_doc_id")
  title                String
  driveUrl             String     @map("drive_url")
  mimeType             String?    @map("mime_type")
  role                 DocRole    @default(REVIEWER)
  status               DocStatus  @default(INBOX)
  accessState          AccessState @default(OK) @map("access_state")
  isStarred            Boolean    @default(false) @map("is_starred")
  lastModifiedInDrive  DateTime?  @map("last_modified_in_drive")    // Drive's modifiedTime (does NOT update when comments change)
  notes                String?    @map("notes")
  owner                String?
  createdTimeInDrive   DateTime?  @map("created_time_in_drive")
  addedAt              DateTime   @default(now()) @map("added_at")  // when this doc was first added to docreview
  commentsLastSyncedAt DateTime?  @map("comments_last_synced_at")   // stamped with sync start time on full success (comments + suggestions); used by refresh to catch up stale docs
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  labels               DocLabel[]
  comments             Comment[]

  @@unique([userId, googleDocId])
  @@map("docs")
}

model Comment {
  commentId       String         @id @default(cuid()) @map("comment_id")
  docId           String         @map("doc_id")
  googleCommentId String         @map("google_comment_id")
  type            CommentType    @default(COMMENT)
  suggestionType  SuggestionType? @map("suggestion_type")
  resolved        Boolean        @default(false)
  isThreadAuthor  Boolean        @default(false) @map("is_thread_author")
  iParticipated   Boolean        @default(false) @map("i_participated")
  isRead          Boolean        @default(false) @map("is_read")
  isStarred       Boolean        @default(false) @map("is_starred")
  status          CommentStatus  @default(INBOX)
  driveCreatedAt  DateTime?      @map("drive_created_at")
  driveModifiedAt DateTime?      @map("drive_modified_at")
  replyCount      Int            @default(0) @map("reply_count")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  doc             Doc            @relation(fields: [docId], references: [docId], onDelete: Cascade)

  @@unique([docId, googleCommentId])
  @@map("comments")
}

model DocLabel {
  docId   String @map("doc_id")
  labelId String @map("label_id")
  doc     Doc    @relation(fields: [docId], references: [docId], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [labelId], onDelete: Cascade)

  @@id([docId, labelId])
  @@map("doc_labels")
}
